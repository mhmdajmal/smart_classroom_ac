# ==========================================
# Teachable Machine Edge AI Telemetry System
# Git Ignore Configuration
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Node.js & Next.js Build Outputs & Dependencies
node_modules/
.next/
out/
build/
dist/
.pnp
.pnp.js

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/*
!logs/.gitkeep

# Dynamic User Uploads
uploads/*
!uploads/.gitkeep

# Environment Files & Secrets
.env
.env*.local

# IDEs & Editor Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
